{
  "name": "brain-games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first entertainment games and personal performance tracking.",
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "apps/sudoku",
    "apps/words"
  ],
  "scripts": {
    "build": "node scripts/build-all.mjs",
    "build:shell": "tsc --noEmit && vite build",
    "test:shared": "node --experimental-strip-types --test tests/storage.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-brain-games \"node --test tests/rules.test.mjs\"",
    "test:unit": "npm run test:unit --workspace=strack && npm run test:unit --workspace=wtrack",
    "test:base-path": "node scripts/check-combined-build.mjs",
    "test:profile": "firebase emulators:exec --only auth,firestore --project demo-brain-games \"playwright test --config playwright.profile.config.ts\"",
    "test:shell": "playwright test",
    "smoke:live": "node scripts/smoke-live.mjs",
    "dev": "vite"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "idb": "^8.0.3"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.10.0",
    "firebase-tools": "^15.30.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  }
}
