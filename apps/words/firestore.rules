rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validId(value) { return value is string && value.size() > 0 && value.size() <= 180; }
    function validApp() {
      let d = request.resource.data;
      return d.keys().hasAll(['version', 'catalogueVersion', 'settingsUpdatedAt', 'preferences', 'progress', 'deletedProgress', 'activePuzzleId'])
        && d.keys().hasOnly(['version', 'catalogueVersion', 'settingsUpdatedAt', 'preferences', 'progress', 'deletedProgress', 'activePuzzleId'])
        && d.version == 1
        && d.catalogueVersion is string && d.catalogueVersion.size() > 0 && d.catalogueVersion.size() <= 40
        && d.settingsUpdatedAt is number && d.settingsUpdatedAt > 0
        && d.preferences is map
        && d.preferences.keys().hasAll(['theme', 'showTimer', 'checkAsYouType'])
        && d.preferences.keys().hasOnly(['theme', 'showTimer', 'checkAsYouType', 'showHints', 'showControlHelp', 'gridTextSize', 'clueTextSize', 'menuTextSize', 'highlightColour'])
        && d.preferences.theme in ['system', 'light', 'dark']
        && d.preferences.showTimer is bool
        && d.preferences.checkAsYouType is bool
        && (!('showHints' in d.preferences) || d.preferences.showHints is bool)
        && (!('showControlHelp' in d.preferences) || d.preferences.showControlHelp is bool)
        && (!('gridTextSize' in d.preferences) || d.preferences.gridTextSize in ['small', 'medium', 'large'])
        && (!('clueTextSize' in d.preferences) || d.preferences.clueTextSize in ['small', 'medium', 'large'])
        && (!('menuTextSize' in d.preferences) || d.preferences.menuTextSize in ['small', 'medium', 'large'])
        && (!('highlightColour' in d.preferences) || d.preferences.highlightColour in ['cyan', 'amber', 'violet', 'green'])
        && d.progress is map && d.progress.size() <= 2000
        && d.deletedProgress is map && d.deletedProgress.size() <= 500
        && (d.activePuzzleId == null || validId(d.activePuzzleId));
    }
    function validProgress(id) {
      let d = request.resource.data;
      return d.version == 1
        && d.id == id && validId(id)
        && d.puzzleId is string && validId(d.puzzleId)
        && d.kind in ['word-search', 'crossword', 'word-grid']
        && d.foundWordIds is list
        && d.entries is list
        && d.hintedCells is list
        && d.updatedAt is number
        && d.cloudRevision is int && d.cloudRevision >= 0;
    }
    function validSettings() {
      let d = request.resource.data;
      return d.version == 1
        && d.cloudRevision is int && d.cloudRevision >= 0
        && d.preferences is map
        && d.settingsUpdatedAt is number
        && d.deletedProgress is map && d.deletedProgress.size() <= 500
        && (d.activePuzzleId == null || validId(d.activePuzzleId));
    }
    match /users/{uid}/state/{documentId} {
      allow read, delete: if isOwner(uid) && documentId == 'app';
      allow create, update: if isOwner(uid)
        && documentId == 'app'
        && validApp();
    }
    match /users/{uid}/wordState/app {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validApp();
    }
    match /users/{uid}/wordProgress/{id} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validProgress(id);
    }
    match /users/{uid}/wordMeta/settings {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validSettings();
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
